{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "vitest.config.qualify.ts", "playwright.config.ts", "scripts/**/*.ts", "tests/unit/**/*.ts", "tests/helpers/**/*.ts", "qualify/**/*.ts", "e2e/**/*.ts", "models/ci-registry.json"],
  "exclude": ["tests/fixtures"]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["./src/engine/*"],
      "@state/*": ["./src/state/*"],
      "@ui/*": ["./src/ui/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.config.qualify.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/helpers/**/*.ts",
    "qualify/**/*.ts",
    "e2e/**/*.ts",
    "models/ci-registry.json"
  ],
  "exclude": [
    "tests/fixtures",
    // unit-204 adversary: uses `expect.fail` (no such member on Playwright's
    // Expect TYPE ALIAS — not augmentable; and undefined at runtime in
    // @playwright/test 1.64.1, only ever reached on a violation path) plus
    // `JSON.parse(match![1])` under noUncheckedIndexedAccess. Frozen spec —
    // excluded from tsc ONLY; Playwright still transpiles and runs it in
    // full, verdicts unchanged (assumptions in the unit report).
    "e2e/pwa/adversarial-headers.spec.ts"
  ]
}

{
  "name": "zipscribe",
  "private": true,
  "version": "0.0.0",
  "description": "Zero-server, browser-only video & audio transcription and caption editor",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "node scripts/preview.mjs",
    "preview:isolated": "ZIPSCRIBE_ISOLATED=1 node scripts/preview.mjs",
    "test": "vitest run",
    "pretest": "node scripts/verify-fixtures.ts --quiet",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures": "node scripts/make-fixtures.ts",
    "fixtures:verify": "node scripts/verify-fixtures.ts",
    "check-bundle": "node scripts/check-bundle.mjs",
    "spec-lint": "node scripts/spec-lint.ts",
    "license-check": "node scripts/license-check.ts",
    "verify:unit": "node scripts/verify-criteria.ts unit",
    "verify:intent": "node scripts/verify-criteria.ts intent",
    "models:fetch": "node scripts/models-fetch.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ffmpeg-static",
      "onnxruntime-node"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "~3.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "30.1.3",
    "prettier": "^3.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
